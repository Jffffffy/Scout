# Copy to .env and fill in. NEVER commit .env.
OPENROUTER_KEY=
# Vision model on OpenRouter (must accept image input)
VISION_MODEL=google/gemini-omni-1.2-flash
ASK_MODEL=google/gemini-omni-1.2-flash
FALLBACK_MODEL=google/gemini-2.5-flash
# true = skip the 80 m GPS check (for demos away from the real places)
DEMO_MODE=true
